# Greengrass V2 component recipe (template).
#
# The build script renders every placeholder. The artifact is a universal
# Linux wheelhouse, so one ZIP serves both Tier 1 architectures. Each manifest
# is explicit: a core must match at least one manifest, and listing only one
# architecture silently excludes the other half of the fleet.
---
RecipeFormatVersion: "2020-01-25"
ComponentName: __COMPONENT_NAME__
ComponentVersion: "__COMPONENT_VERSION__"
ComponentDescription: "Collects normalized telemetry and publishes it to AWS IoT Core through the Greengrass nucleus IPC."
ComponentPublisher: "Edge Platform"

ComponentConfiguration:
  DefaultConfiguration:
    gatewayId: "__GATEWAY_ID__"
    deviceId: "__DEVICE_ID__"
    logLevel: "INFO"
    accessControl:
      aws.greengrass.ipc.mqttproxy:
        "__COMPONENT_NAME__:mqttproxy:1":
          policyDescription: "Allow this component to publish telemetry through the nucleus."
          operations:
            - "aws.greengrass.ipc.mqttproxy:publish"
          resources:
            - "edge/*/telemetry"

Manifests:
  - Platform:
      os: linux
      architecture: arm64
    Artifacts:
      - URI: "s3://__BUCKET__/__COMPONENT_NAME__/__COMPONENT_VERSION__/__ARTIFACT_NAME__"
        Unarchive: ZIP
    Lifecycle:
      Install:
        Timeout: 600
        Script: |
          set -eu
          ART="{artifacts:decompressedPath}/__ARTIFACT_STEM__"
          python3 -m venv "{work:path}/venv"
          "{work:path}/venv/bin/pip" install \
            --no-index --find-links "$ART/wheels" "edge-collector[aws]==__DIST_VERSION__"
      Run:
        Script: |
          set -eu
          cat > "{work:path}/collector.yaml" <<EOF
          gateway_id: "{configuration:/gatewayId}"
          log_level: "{configuration:/logLevel}"
          batching:
            queue_max: 1000
            overflow_policy: drop_oldest
            max_samples: 10
            flush_interval_s: 1.0
          health:
            enabled: true
            host: 127.0.0.1
            port: 8081
          sink:
            kind: greengrass
            qos: 1
          spool:
            enabled: true
            path: "{work:path}/spool.sqlite3"
            max_bytes: 67108864
            replay_interval_s: 1.0
          sources:
            synthetic:
              enabled: true
              device_id: "{configuration:/deviceId}"
              interval_s: 1.0
              metrics:
                - name: temperature
                  value: 21.5
                  step: 0.1
                  unit: degC
          EOF
          exec "{work:path}/venv/bin/edge-collector" --config "{work:path}/collector.yaml"

  - Platform:
      os: linux
      architecture: amd64
    Artifacts:
      - URI: "s3://__BUCKET__/__COMPONENT_NAME__/__COMPONENT_VERSION__/__ARTIFACT_NAME__"
        Unarchive: ZIP
    Lifecycle:
      Install:
        Timeout: 600
        Script: |
          set -eu
          ART="{artifacts:decompressedPath}/__ARTIFACT_STEM__"
          python3 -m venv "{work:path}/venv"
          "{work:path}/venv/bin/pip" install \
            --no-index --find-links "$ART/wheels" "edge-collector[aws]==__DIST_VERSION__"
      Run:
        Script: |
          set -eu
          cat > "{work:path}/collector.yaml" <<EOF
          gateway_id: "{configuration:/gatewayId}"
          log_level: "{configuration:/logLevel}"
          batching:
            queue_max: 1000
            overflow_policy: drop_oldest
            max_samples: 10
            flush_interval_s: 1.0
          health:
            enabled: true
            host: 127.0.0.1
            port: 8081
          sink:
            kind: greengrass
            qos: 1
          spool:
            enabled: true
            path: "{work:path}/spool.sqlite3"
            max_bytes: 67108864
            replay_interval_s: 1.0
          sources:
            synthetic:
              enabled: true
              device_id: "{configuration:/deviceId}"
              interval_s: 1.0
              metrics:
                - name: temperature
                  value: 21.5
                  step: 0.1
                  unit: degC
          EOF
          exec "{work:path}/venv/bin/edge-collector" --config "{work:path}/collector.yaml"
