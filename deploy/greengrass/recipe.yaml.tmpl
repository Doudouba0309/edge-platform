# Greengrass V2 component recipe (template).
#
# The build script renders every placeholder. The artifact is a universal
# Linux wheelhouse, so one ZIP serves both Tier 1 architectures. Each manifest
# is explicit: a core must match at least one manifest, and listing only one
# architecture silently excludes the other half of the fleet.
---
RecipeFormatVersion: "2020-01-25"
ComponentName: __COMPONENT_NAME__
ComponentVersion: "__COMPONENT_VERSION__"
ComponentDescription: "Collects normalized telemetry and publishes it to AWS IoT Core through the Greengrass nucleus IPC."
ComponentPublisher: "Edge Platform"

ComponentConfiguration:
  DefaultConfiguration:
    gatewayId: "__GATEWAY_ID__"
    deviceId: "__DEVICE_ID__"
    sourceMode: "synthetic"
    logLevel: "INFO"
    accessControl:
      aws.greengrass.ipc.mqttproxy:
        "__COMPONENT_NAME__:mqttproxy:telemetry":
          policyDescription: "Allow this component to publish telemetry through the nucleus."
          operations:
            - "aws.greengrass#PublishToIoTCore"
          resources:
            - "edge/+/+/telemetry"
        "__COMPONENT_NAME__:mqttproxy:status":
          policyDescription: "Allow this component to publish gateway presence and heartbeat."
          operations:
            - "aws.greengrass#PublishToIoTCore"
          resources:
            - "edge/+/status"

Manifests:
  - Platform:
      os: linux
      architecture: aarch64
    Artifacts:
      - URI: "s3://__BUCKET__/__COMPONENT_NAME__/__COMPONENT_VERSION__/__ARTIFACT_NAME__"
        Unarchive: ZIP
    Lifecycle:
      Install:
        Timeout: 600
        Script: |
          set -eu
          ART="{artifacts:decompressedPath}/__ARTIFACT_STEM__"
          python3 -m venv "{work:path}/venv"
          "{work:path}/venv/bin/pip" install --force-reinstall \
            --no-index --find-links "$ART/wheels" "edge-collector[aws]==__DIST_VERSION__"
      Run:
        Script: |
          set -eu
          ART="{artifacts:decompressedPath}/__ARTIFACT_STEM__"
          cat > "{work:path}/collector.yaml" <<EOF
          gateway_id: "{configuration:/gatewayId}"
          component_version: "__COMPONENT_VERSION__"
          log_level: "{configuration:/logLevel}"
          log_json: true
          log_file: "{work:path}/collector.jsonl"
          status_enabled: true
          status_interval_s: 30
          batching:
            queue_max: 1000
            overflow_policy: drop_oldest
            max_samples: 10
            flush_interval_s: 1.0
          health:
            enabled: true
            host: 127.0.0.1
            port: 8081
          sink:
            kind: greengrass
            qos: 1
          spool:
            enabled: true
            path: "{work:path}/spool.sqlite3"
            max_bytes: 67108864
            replay_interval_s: 1.0
          EOF
          cat >> "{work:path}/collector.yaml" <<EOF
          sources:
          EOF
          if [ "{configuration:/sourceMode}" = "modbus_tcp" ]; then
            cp "$ART/pointmaps/point-map.yaml" "{work:path}/point-map.yaml"
            cat >> "{work:path}/collector.yaml" <<EOF
            modbus_tcp:
              enabled: true
              point_map: "{work:path}/point-map.yaml"
          EOF
          else
            cat >> "{work:path}/collector.yaml" <<EOF
            synthetic:
              enabled: true
              device_id: "{configuration:/deviceId}"
              interval_s: 1.0
              metrics:
                - name: temperature
                  value: 21.5
                  step: 0.1
                  unit: degC
          EOF
          fi
          exec "{work:path}/venv/bin/edge-collector" --config "{work:path}/collector.yaml"

  - Platform:
      os: linux
      architecture: amd64
    Artifacts:
      - URI: "s3://__BUCKET__/__COMPONENT_NAME__/__COMPONENT_VERSION__/__ARTIFACT_NAME__"
        Unarchive: ZIP
    Lifecycle:
      Install:
        Timeout: 600
        Script: |
          set -eu
          ART="{artifacts:decompressedPath}/__ARTIFACT_STEM__"
          python3 -m venv "{work:path}/venv"
          "{work:path}/venv/bin/pip" install --force-reinstall \
            --no-index --find-links "$ART/wheels" "edge-collector[aws]==__DIST_VERSION__"
      Run:
        Script: |
          set -eu
          ART="{artifacts:decompressedPath}/__ARTIFACT_STEM__"
          cat > "{work:path}/collector.yaml" <<EOF
          gateway_id: "{configuration:/gatewayId}"
          component_version: "__COMPONENT_VERSION__"
          log_level: "{configuration:/logLevel}"
          log_json: true
          log_file: "{work:path}/collector.jsonl"
          status_enabled: true
          status_interval_s: 30
          batching:
            queue_max: 1000
            overflow_policy: drop_oldest
            max_samples: 10
            flush_interval_s: 1.0
          health:
            enabled: true
            host: 127.0.0.1
            port: 8081
          sink:
            kind: greengrass
            qos: 1
          spool:
            enabled: true
            path: "{work:path}/spool.sqlite3"
            max_bytes: 67108864
            replay_interval_s: 1.0
          EOF
          cat >> "{work:path}/collector.yaml" <<EOF
          sources:
          EOF
          if [ "{configuration:/sourceMode}" = "modbus_tcp" ]; then
            cp "$ART/pointmaps/point-map.yaml" "{work:path}/point-map.yaml"
            cat >> "{work:path}/collector.yaml" <<EOF
            modbus_tcp:
              enabled: true
              point_map: "{work:path}/point-map.yaml"
          EOF
          else
            cat >> "{work:path}/collector.yaml" <<EOF
            synthetic:
              enabled: true
              device_id: "{configuration:/deviceId}"
              interval_s: 1.0
              metrics:
                - name: temperature
                  value: 21.5
                  step: 0.1
                  unit: degC
          EOF
          fi
          exec "{work:path}/venv/bin/edge-collector" --config "{work:path}/collector.yaml"
